{
  "name": "@aepyornis/fastboot.ts",
  "version": "0.0.15",
  "description": "Fastboot using WebUSB",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "esbuild": "tsc --noEmit && esbuild src/index.ts --bundle --sourcemap --format=esm --platform=browser --target=chrome132 --outfile=dist/fastboot.js",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "tsc": "tsc",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Ziggy, Calyx Institute",
  "license": "MIT",
  "devDependencies": {
    "@types/w3c-web-usb": "^1.0.14",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26"
  }
}
